# Copy to .env locally and fill with deployment-specific values.

GOS_MYSQL_PASSWORD=replace-with-mysql-user-password
GOS_MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
GOS_AUTH_ADMIN_PASSWORD=replace-with-admin-password
GOS_SECURITY_ENCRYPTION_KEY=replace-with-strong-encryption-key

# Optional metrics endpoint. The UI's metrics access switch controls authentication.
# Configure a separate token to use protected access; anonymous access needs none.
GOS_METRICS_ENABLED=false
GOS_METRICS_BEARER_TOKEN=
GOS_METRICS_REFRESH_INTERVAL_SEC=30
GOS_METRICS_COLLECTION_TIMEOUT_SEC=5
GOS_METRICS_BUSINESS_SOURCES=[]

{
  "auth": {
    "admin_display_name": "Administrator",
    "admin_password": "change-me-local-admin-password",
    "admin_username": "admin",
    "session_ttl_hours": 24
  },
  "database": {
    "conn_max_idle_time_sec": 600,
    "conn_max_lifetime_sec": 1800,
    "driver": "sqlite",
    "max_idle_conns": 5,
    "max_open_conns": 10,
    "mysql_dsn": "",
    "ping_timeout_sec": 5,
    "startup_max_retries": 10,
    "startup_retry_interval_sec": 2
  },
  "environment": "local",
  "jenkins": {
    "api_token": "",
    "auto_sync_enabled": true,
    "auto_sync_interval_sec": 5,
    "base_url": "http://127.0.0.1:8080",
    "enabled": false,
    "release_track_enabled": true,
    "release_track_interval_sec": 10,
    "startup_check_enabled": false,
    "startup_max_retries": 5,
    "startup_retry_interval_sec": 2,
    "timeout_sec": 60,
    "username": "admin"
  },
  "release": {
    "concurrency": {
      "conflict_strategy": "reject",
      "enabled": true,
      "lock_scope": "application_env",
      "lock_timeout_sec": 1800
    },
    "env_options": [
      "dev",
      "prod"
    ]
  },
  "security": {
    "encryption_key": ""
  },
  "server": {
    "addr": ":8081",
    "idle_timeout_sec": 60,
    "read_header_timeout_sec": 5,
    "read_timeout_sec": 120,
    "shutdown_timeout_sec": 10,
    "write_timeout_sec": 120
  }
}
